# 複製本檔為 .env 並填入金鑰。.env 不應提交到版本控制。

# FinMind 台股資料 API token（免費註冊取得）
# https://finmindtrade.com/
FINMIND_TOKEN=

# 無狀態（公開試用）模式：設為 1/true 時，觀察清單與投組改走 session，
# 重整即歸零、完全不寫磁碟，也不吃 portfolio.yaml 種子。
# 本機單機版請「留空」以維持寫檔記憶；雲端公開部署才開。
STOCKBOT_STATELESS=

# --- 通知管道（v1 尚未啟用，之後選定再填）---
# Discord Webhook URL
# DISCORD_WEBHOOK_URL=
# ntfy.sh topic
# NTFY_TOPIC=
